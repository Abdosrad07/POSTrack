# Développement (recommandé) : laisser "/api" pour passer par le proxy Vite
# (vite.config.ts -> server.proxy). Aucun souci de CORS ni d'IPv4/IPv6.
VITE_API_URL=/api

# Alternative : URL absolue vers le backend (build de prod, backend distant).
# Éviter "localhost" si le backend n'est pas en dual-stack :
#   VITE_API_URL=http://127.0.0.1:8000/api      (backend IPv4)
#   VITE_API_URL=http://[::1]:8000/api          (backend IPv6)
#   VITE_API_URL=http://192.168.1.10:8000/api   (réseau/VM/Docker)
# VITE_API_URL=/api

# Mettre à true pour masquer les bandeaux/décorations de données de démonstration
# quand le backend réel est disponible.
VITE_DISABLE_DEMO_BANNER=false

# Active les logs techniques BTS dans la console navigateur.
VITE_BTS_DEBUG=false

# Base de donnees
# Pour la production (MySQL) :
# DATABASE_URL=mysql+pymysql://postrack_user:motdepasse@localhost:3306/postrack
# Pour le developpement / demo rapide (SQLite, aucune installation requise) :
DATABASE_URL=sqlite:///./postrack.db

# Securite JWT
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS : origines autorisees, separees par des virgules.
# "*" convient au developpement local. En production, restreindre a la
# ou les origines reelles du frontend, ex :
# ALLOWED_ORIGINS=https://app.postrack.cm,https://admin.postrack.cm
ALLOWED_ORIGINS=*

# Seuil de saturation BTS (%) pour les alertes du Dashboard
BTS_SATURATION_THRESHOLD=80.0

# Nombre de jours avant expiration d'un POS pour declencher une alerte
# sur le Dashboard Partenaire
POS_EXPIRATION_ALERT_DAYS=30

# Divers
ENVIRONMENT=development
